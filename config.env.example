# Copy to config.env and fill in. Keep it out of git, it holds your access token
# and API keys.

# Matrix homeserver URL (client API endpoint).
MATRIX_URL=https://matrix.example.org
# The bot's Matrix user. Use a DIFFERENT account/device than jellyseerr-matrix-bot
# (the notifier) - each bot needs its own crypto store and device identity.
MATRIX_USER_ID=@jellyseerr-request-bot:example.org
# Access token + device ID from the login call, see jellyseerr-matrix-bot's
# docs/setup.md (same procedure, different account).
MATRIX_TOKEN=syt_...
MATRIX_DEVICE_ID=ABCDEFGHIJ
# Same room as jellyseerr-matrix-bot's notifications, or a different one -
# invite the bot, it joins on its own.
MATRIX_ROOM_ID=!yourroomid:example.org

# Base URL of your Jellyseerr API, including /api/v1.
JELLYSEERR_API_URL=https://jellyseerr.example.org/api/v1
# API key from Jellyseerr -> Settings -> General.
JELLYSEERR_API_KEY=
# Optional: base URL of your Jellyseerr (no /api/v1), used for deep links in
# results. Empty: plain text only.
JELLYSEERR_URL=https://jellyseerr.example.org

# OpenAI API key used to parse free-text requests (title/year/season).
OPENAI_API_KEY=
# Optional: defaults to gpt-4.1-nano.
OPENAI_MODEL=gpt-4.1-nano

# Optional: command prefix users type to search/request. Default: !request
REQUEST_TRIGGER_PREFIX=!request
# Optional: how long a "reply with 1/2/yes/no" confirmation stays valid, in
# seconds. Default: 300 (5 minutes).
REQUEST_CONFIRM_TIMEOUT_SECONDS=300

# Bot language for the bot's own messages (usage hints, confirmations,
# cancellations): en or de. Default: en. Does not affect the LLM's own answers,
# it always replies in the language the user wrote in.
BOT_LANG=en
